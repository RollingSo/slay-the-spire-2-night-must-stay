[gd_resource type="ShaderMaterial" load_steps=3 format=3]

[ext_resource type="Texture2D" path="res://ironeye_assets/energy_icon/ironeye_energy_card_icon.png" id="1_texture"]

[sub_resource type="Shader" id="Shader_ironeye_transition"]
code = "shader_type canvas_item;

uniform sampler2D transitionTex;
uniform float threshold : hint_range(0,1);

void fragment() {
    float falloff = 1.0 - texture(transitionTex, UV).a;
    float remap = mix(-0.1, 1.1, threshold);
    falloff = step(falloff, remap);
    COLOR.a = falloff;
}
"

[resource]
resource_local_to_scene = true
shader = SubResource("Shader_ironeye_transition")
shader_parameter/threshold = 0.0
shader_parameter/transitionTex = ExtResource("1_texture")
