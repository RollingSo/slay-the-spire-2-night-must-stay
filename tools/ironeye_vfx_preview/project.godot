config_version=5

[application]
config/name="Ironeye VFX Review"
run/main_scene="res://preview.tscn"

[display]
window/size/viewport_width=2400
window/size/viewport_height=810

[dotnet]
project/assembly_name="IroneyeVfxPreview"

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.055, 0.075, 1)
