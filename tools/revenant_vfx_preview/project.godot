config_version=5

[application]
config/name="Revenant VFX Review"
run/main_scene="res://preview.tscn"

[display]
window/size/viewport_width=1440
window/size/viewport_height=1100

[dotnet]
project/assembly_name="RevenantVfxPreview"

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.045, 0.035, 0.06, 1)
