extends SceneTree
var checks: Array = []
func check(name,passed):
	checks.append({"name":name,"passed":passed})
	print("PASS " if passed else "FAIL ",name)
func step(rig,seconds):
	for i in range(roundi(seconds*120)): rig._process(1.0/120.0)
func _initialize():
	create_timer(20).timeout.connect(func(): push_error("Animation validation timed out"); quit(2))
	call_deferred("run")
func run():
	var args = OS.get_cmdline_user_args()
	check("pack_mount",args[0] == "SOURCE" or ProjectSettings.load_resource_pack(args[0]))
	var packed = load("res://ironeye_assets/combat_rig/ironeye_combat_visuals.tscn")
	check("combat_scene_loaded",packed is PackedScene)
	if not packed is PackedScene: quit(1); return
	var scene = packed.instantiate()
	root.add_child(scene)
	var rig = scene.get_node("Visuals/Prototype")
	check("combat_script_ready",rig.has_method("set_playback_mode") and rig.has_method("get_shot_origin"))
	if not rig.has_method("set_playback_mode") or not rig.has_method("get_shot_origin"):
		if args.size()>1:
			FileAccess.open(args[1],FileAccess.WRITE).store_string(JSON.stringify({"checks":checks,"failed":1},"\t"))
		quit(1)
		return
	rig.set_process(false)
	var sprite = rig.get_node("SequenceSprite")
	var frames = sprite.sprite_frames
	check("five_actions",frames.get_animation_names().size() == 5)
	var rect = frames.get_frame_texture("idle",0).get_image().get_used_rect()
	var top = sprite.get_global_transform()*(Vector2(rect.position)+sprite.offset)
	var bottom = sprite.get_global_transform()*(Vector2(rect.position+rect.size)+sprite.offset)
	check("approved_visible_height",absf(bottom.y-top.y-323.733564)<0.001)
	check("ground_zero",absf(bottom.y)<0.001)
	check("bounds_width_250",scene.get_node("Bounds").size.x == 250)
	check("marker_positions_retained",scene.get_node("IntentPos").position.is_equal_approx(Vector2(7.35,-347.721864)) and scene.get_node("CenterPos").position.is_equal_approx(Vector2(0,-161.871864)))
	rig.set_playback_mode("Normal")
	rig.set_action_timing("Attack",.15)
	rig.play_trigger("Attack")
	step(rig,.15)
	check("normal_shot_release_at_native_wait",sprite.animation == "attack" and sprite.frame == 11)
	check("shot_origin_follows_all_scales",rig.get_shot_origin().is_equal_approx(Vector2(131,-217)*0.9991776666666666))
	rig.play_trigger("AttackDagger")
	step(rig,.15)
	check("knife_peak_at_native_wait",sprite.animation == "dagger" and sprite.frame == 6)
	rig.play_trigger("Hit")
	step(rig,.5)
	check("hit_interrupt_and_return",sprite.animation == "idle")
	rig.play_trigger("Cast")
	step(rig,.25)
	check("cast_release_at_native_wait",sprite.animation == "cast" and sprite.frame == 9)
	rig.play_trigger("PowerUp")
	check("powerup_uses_cast",sprite.animation == "cast" and sprite.frame == 0)
	rig.set_action_timing("Attack",.30)
	rig.play_trigger("Attack")
	step(rig,.30)
	check("custom_command_delay_retained",sprite.frame == 11)
	rig.set_playback_mode("Fast")
	rig.play_trigger("Attack")
	step(rig,.075)
	check("fast_release_at_half_wait",sprite.frame == 11)
	rig.play_trigger("Attack")
	check("same_attack_restarts",sprite.frame == 0)
	rig.set_playback_mode("Instant")
	rig.play_trigger("AttackDagger")
	check("instant_skips_oneshot",sprite.animation == "idle")
	rig.set_playback_mode("Normal")
	rig.play_trigger("Dead")
	rig.animation_player.advance(.85)
	check("legacy_death_preserved",not sprite.visible and rig.legacy_root.visible and rig.legacy_root.modulate.a < .01)
	rig.play_trigger("Attack")
	step(rig,2)
	check("dead_blocks_late_attack",not sprite.visible)
	rig.play_trigger("Revive")
	check("revive_resets_alpha_and_idle",sprite.visible and sprite.animation == "idle" and rig.legacy_root.modulate.a > .99)
	rig.play_trigger("LowHealth")
	check("low_health_reuses_idle",sprite.animation == "idle")
	check("baked_arrow_not_in_release",frames.get_frame_texture("attack",11).get_image().get_used_rect().end.x < 300)
	var failed = checks.filter(func(c):return not c.passed)
	if args.size()>1:
		FileAccess.open(args[1],FileAccess.WRITE).store_string(JSON.stringify({"checks":checks,"passed":checks.size()-failed.size(),"failed":failed.size()},"\t"))
	scene.queue_free()
	quit(0 if failed.is_empty() else 1)
