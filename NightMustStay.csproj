<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AssemblyName>NightMustStay</AssemblyName>
    <Sts2AssemblyDir Condition="'$(Sts2AssemblyDir)' == ''">$(MSBuildProjectDirectory)\sts2dll</Sts2AssemblyDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tools\**\*.cs" />
    <Compile Remove=".godot\**\*.cs" />
    <Compile Remove="build\**\*.cs" />
    <EmbeddedResource Include="config.json" LogicalName="NightMustStay.telemetry.config.json" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(Sts2AssemblyDir)\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(Sts2AssemblyDir)\GodotSharp.dll</HintPath>
    </Reference>
    <Reference Include="sts2">
      <HintPath>$(Sts2AssemblyDir)\sts2.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
